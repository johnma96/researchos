# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ──
.venv/
venv/

# ── Environment variables (NEVER commit API keys) ──
.env
.env.local
.env.production

# ── Data (local persistence — too large for git) ──
data/chroma/
data/raw/*
!data/raw/.gitkeep
*.pdf

# ── IDE ──
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── Testing / Coverage ──
.coverage
htmlcov/
.pytest_cache/

# ── MyPy / Ruff ──
.mypy_cache/
.ruff_cache/

# ── Logs ──
*.log
logs/

# ── Docker ──
docker-compose.override.yml

# ── Jupyter ──
.ipynb_checkpoints/

# ── uv ──
.uv_cache/
