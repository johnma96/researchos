# ══════════════════════════════════════════════════════════════
# ResearchOS — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════

# ── Environment ──
ENVIRONMENT=development

# ── LLM (V1) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram (V1) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Embeddings ──
# Leave blank to download from HuggingFace. Set to a local directory path on
# networks where HuggingFace is blocked (e.g. corporate environments).
# EMBEDDING_MODEL_LOCAL_PATH=/absolute/path/to/all-MiniLM-L6-v2

# ── Vector store ──
VECTOR_STORE=chroma

# ── Memory ──
MEMORY_STORE=in_memory

# ── News (V2) ──
# NEWSAPI_KEY=

# ── Monitoring (V3) ──
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000

# ── GCP (V4) ──
# GOOGLE_CLOUD_PROJECT=
